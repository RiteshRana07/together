# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string

# --- Application ---
APP_URL=http://localhost:3000

# --- Transactional email (Brevo HTTPS API; no SMTP required) ---
# Create an API key in Brevo: Settings -> SMTP & API -> API Keys & MCP
BREVO_API_KEY=
# This email address must be a verified Brevo sender.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=WatchTogether

# --- Database (Postgres) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- pCloud storage ---
# Use the API host for your pCloud data center: api.pcloud.com (US) or eapi.pcloud.com (Europe).
PCLOUD_API_HOST=https://api.pcloud.com
PCLOUD_ACCESS_TOKEN=
PCLOUD_FOLDER=/WatchTogether
PCLOUD_FOLDER_ID=
# Create a File Request for the WatchTogether folder in my.pCloud, then paste the code from its link here.
PCLOUD_UPLOAD_LINK_CODE=
# Direct room playback prefers a transcoded variant up to this height.
PCLOUD_PLAYBACK_MAX_HEIGHT=720

# --- Real-time sync (Pusher Channels) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- Optional WebRTC room calls ---
# Add a TURN server for reliable calls across restrictive networks.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Cloudflare Realtime TURN (server-side only; never expose the API token)
# Generate short-lived browser ICE credentials from the TURN key.

# Video calls use free STUN-only WebRTC. No TURN account is required.
